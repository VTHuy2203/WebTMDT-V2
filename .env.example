# API Configuration (Standard Vite Prefix)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_MODE=http
VITE_APP_ENV=development
VITE_CLIENT_APP=buyer

# Sentry error monitoring (use a separate DSN per deployed app)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_VERIFY_ON_STARTUP=false
SERVICE_NAME=marketplace-api
# Use a stable random value in deployed environments to pseudonymize user IDs in logs.
LOG_HASH_SALT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3101
LOKI_PORT=3100
ALLOY_PORT=12345
VITE_SENTRY_DSN_BUYER=
VITE_SENTRY_DSN_SELLER=
VITE_SENTRY_DSN_ADMIN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_VERIFY_ON_STARTUP=false

# CDN / Assets
VITE_CDN_URL=https://cdn.marketplace.local
CDN_PUBLIC_BASE_URL=

# Phase 2 infrastructure
DATABASE_URL=postgresql://marketplace:marketplace@localhost:6432/marketplace?schema=public&connection_limit=10
DIRECT_URL=postgresql://marketplace:marketplace@localhost:5433/marketplace?schema=public
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=replace-with-at-least-16-random-characters
SEARCH_TIMEOUT_MS=1500
CATALOG_RATE_LIMIT_MAX=750
CATALOG_RATE_LIMIT_WINDOW_MS=1000
SHIPPING_PROVIDER=LOCAL
LOCAL_SHIPPING_FEE=30000
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_SERVICE_TYPE_ID=2
GHN_PAYMENT_TYPE_ID=1
GHN_REQUIRED_NOTE=KHONGCHOXEMHANG
# true for Vietnam's post-2025 two-level province/ward address model when the
# saved address names come from GHN v3 master data.
GHN_NEW_ADDRESS_MODEL=false
DEFAULT_ITEM_WEIGHT_GRAMS=500
DEFAULT_PARCEL_LENGTH_CM=20
DEFAULT_PARCEL_WIDTH_CM=15
DEFAULT_PARCEL_HEIGHT_CM=10

# Portals URLs
VITE_SELLER_URL=http://localhost:3001
VITE_ADMIN_URL=http://localhost:3002

# SePay Payment Gateway Configuration (VietQR)
VITE_SEPAY_DISPLAY_NAME=MARKETPLACE VIETNAM
VITE_SEPAY_BANK_NAME=MBBank (Ngân hàng Quân Đội)
VITE_SEPAY_ACC_NUMBER=09876543210
VITE_SEPAY_ACC_NAME=CONG TY CO PHAN CONG NGHE MARKETPLACE

# Backward compatibility (optional fallback)
# NEXT_PUBLIC_API_BASE_URL=https://api.marketplace.local/v1
# NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_APP_ENV=development
