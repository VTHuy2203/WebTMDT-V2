model PaymentIntent {
  id              String                  @id @default(uuid()) @db.Uuid
  orderGroupId    String                  @map("order_group_id") @db.Uuid
  provider        String
  paymentCode     String                  @unique @map("payment_code")
  status          PaymentStatus           @default(CREATED)
  amount          BigInt
  currency        String                  @default("VND") @db.VarChar(3)
  providerData    Json?                   @map("provider_data") @db.JsonB
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(6)
  paidAt          DateTime?               @map("paid_at") @db.Timestamptz(6)
  version         Int                     @default(1)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderGroup      OrderGroup              @relation(fields: [orderGroupId], references: [id])
  transactions    PaymentTransaction[]
  reconciliations PaymentReconciliation[]
  reservations    InventoryReservation[]

  @@index([orderGroupId, status])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

model PaymentTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  paymentIntentId       String?                @map("payment_intent_id") @db.Uuid
  provider              String
  externalTransactionId String                 @map("external_transaction_id")
  amount                BigInt
  currency              String                 @default("VND") @db.VarChar(3)
  transferContent       String?                @map("transfer_content")
  occurredAt            DateTime               @map("occurred_at") @db.Timestamptz(6)
  receivedAt            DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  paymentIntent         PaymentIntent?         @relation(fields: [paymentIntentId], references: [id])
  webhookEvents         PaymentWebhookEvent[]
  reconciliation        PaymentReconciliation?

  @@unique([provider, externalTransactionId])
  @@index([paymentIntentId, occurredAt])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                   String              @id @default(uuid()) @db.Uuid
  provider             String
  providerEventId      String              @map("provider_event_id")
  paymentTransactionId String?             @map("payment_transaction_id") @db.Uuid
  payloadHash          String              @map("payload_hash")
  payloadEncrypted     Bytes?              @map("payload_encrypted")
  signatureValid       Boolean             @map("signature_valid")
  receivedAt           DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt          DateTime?           @map("processed_at") @db.Timestamptz(6)
  transaction          PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
  @@map("payment_webhook_events")
}

model PaymentReconciliation {
  id                   String               @id @default(uuid()) @db.Uuid
  paymentIntentId      String?              @map("payment_intent_id") @db.Uuid
  paymentTransactionId String               @unique @map("payment_transaction_id") @db.Uuid
  status               ReconciliationStatus @default(OPEN)
  reasonCode           String               @map("reason_code")
  notes                String?
  resolvedBy           String?              @map("resolved_by") @db.Uuid
  resolvedAt           DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  intent               PaymentIntent?       @relation(fields: [paymentIntentId], references: [id])
  transaction          PaymentTransaction   @relation(fields: [paymentTransactionId], references: [id])

  @@index([status, createdAt])
  @@map("payment_reconciliations")
}

model DigitalDelivery {
  id              String         @id @default(uuid()) @db.Uuid
  orderItemId     String         @map("order_item_id") @db.Uuid
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  status          DeliveryStatus @default(PREPARING)
  revealCount     Int            @default(0) @map("reveal_count")
  readyAt         DateTime?      @map("ready_at") @db.Timestamptz(6)
  revealedAt      DateTime?      @map("revealed_at") @db.Timestamptz(6)
  deliveredAt     DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
