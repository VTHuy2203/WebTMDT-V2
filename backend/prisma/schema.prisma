  @@map("audit_logs")
}

/// Flexible persistence for non-financial extension resources while their dedicated
/// bounded-context tables are introduced. Never store credentials, passwords or KYC here.
model ResourceDocument {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  ownerId   String?  @map("owner_id") @db.Uuid
  shopId    String?  @map("shop_id") @db.Uuid
  slug      String?
  status    String?
  document  Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([kind, slug])
  @@index([kind, status, createdAt])
  @@index([kind, ownerId, createdAt])
  @@index([kind, shopId, createdAt])
  @@map("resource_documents")
}

model MediaObject {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  objectKey   String    @unique @map("object_key")
  bucket      String
  purpose     String
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  checksum    String?
  status      String    @default("PENDING")
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  publicUrl   String?   @map("public_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
  @@index([entityType, entityId])
  @@map("media_objects")
}

model Conversation {
  id                String                    @id @default(uuid()) @db.Uuid
  orderId           String?                   @map("order_id") @db.Uuid
  subject           String
  status            String                    @default("OPEN")
  automationEnabled Boolean                   @default(true) @map("automation_enabled")
  handoffAt         DateTime?                 @map("handoff_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order?                    @relation(fields: [orderId], references: [id])
  participants      ConversationParticipant[]
  messages          Message[]

  @@index([orderId, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(6)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  attachments    Json         @default("[]") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
