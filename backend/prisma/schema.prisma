generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ShopStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  BANNED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductType {
  PHYSICAL
  DIGITAL_GAME_ACCOUNT
  DIGITAL_APP_ACCOUNT
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  HIDDEN
  ARCHIVED
}

enum AppFulfillmentType {
  PRE_CREATED_ACCOUNT
  LICENSE_KEY
  BUYER_EMAIL_ACTIVATION
  FAMILY_OR_TEAM_INVITATION
  MANUAL_SERVICE
}

enum DurationUnit {
  DAY
  MONTH
  YEAR
}

enum InventoryType {
  PHYSICAL_UNIT
  GAME_CREDENTIAL
  APP_CREDENTIAL
  LICENSE_KEY
  SLOT
}

enum InventoryStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  DISABLED
  QUARANTINED
  REVOKED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  COMPLETED
  EXPIRED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  EXPIRED
  REVIEW_REQUIRED
  REJECTED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReconciliationStatus {
  OPEN
  MATCHED
  APPROVED
  REJECTED
  CLOSED
}

enum DeliveryStatus {
  NOT_AVAILABLE
  PREPARING
  READY
  REVEALED
  REPORTED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum DisputeStatus {
  OPEN
  SELLER_RESPONSE_PENDING
  ADMIN_REVIEW
  RESOLVED_REPLACED
  RESOLVED_REFUNDED
  DISMISSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  REVERSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  emailNormalized      String?                   @unique @map("email_normalized")
  phoneNormalized      String?                   @unique @map("phone_normalized")
  passwordHash         String                    @map("password_hash")
  fullName             String                    @map("full_name")
  status               UserStatus                @default(ACTIVE)
  emailVerifiedAt      DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt      DateTime?                 @map("phone_verified_at") @db.Timestamptz(6)
  failedLoginCount     Int                       @default(0) @map("failed_login_count")
  lockedUntil          DateTime?                 @map("locked_until") @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  sessions             Session[]
  roles                UserRole[]
  sellerApplications   SellerApplication[]
  shopMemberships      ShopMember[]
  carts                Cart[]
  orderGroups          OrderGroup[]
  auditLogs            AuditLog[]                @relation("AuditActor")
  mediaObjects         MediaObject[]
  conversationMembers  ConversationParticipant[]
  sentMessages         Message[]
  notifications        Notification[]
  identityVerification IdentityVerification?
  accountTokens        AccountToken[]
  warrantyClaims       WarrantyClaim[]
  returnRequests       ReturnRequest[]
  shopEngagements      ShopEngagement[]
  shopReviews          ShopReview[]

  @@index([status, createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SellerApplication {
  id              String                  @id @default(uuid()) @db.Uuid
  applicantId     String                  @map("applicant_id") @db.Uuid
  status          SellerApplicationStatus @default(DRAFT)
  businessType    String                  @map("business_type")
  legalName       String                  @map("legal_name")
  taxCode         String?                 @map("tax_code")
  encryptedKyc    Bytes?                  @map("encrypted_kyc")
  keyVersion      Int?                    @map("key_version")
  submittedAt     DateTime?               @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?                 @map("rejection_reason")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicant       User                    @relation(fields: [applicantId], references: [id])
  shop            Shop?

  @@index([status, submittedAt])
  @@map("seller_applications")
}

model Shop {
  id                  String             @id @default(uuid()) @db.Uuid
  sellerApplicationId String?            @unique @map("seller_application_id") @db.Uuid
  slug                String             @unique
  name                String
  description         String?
  status              ShopStatus         @default(DRAFT)
  ratingAverage       Decimal            @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount         Int                @default(0) @map("rating_count")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  application         SellerApplication? @relation(fields: [sellerApplicationId], references: [id])
  members             ShopMember[]
  products            Product[]
  orders              Order[]
  wallets             Wallet[]
  engagements         ShopEngagement[]
  reviews             ShopReview[]
  payouts             PayoutRequest[]

  @@index([status, createdAt])
  @@map("shops")
}

model ShopMember {
  shopId    String         @map("shop_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      ShopMemberRole
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId, isActive])
  @@map("shop_members")
}

model Category {
  id              String     @id @default(uuid()) @db.Uuid
  parentId        String?    @map("parent_id") @db.Uuid
  slug            String     @unique
  name            String
  attributeSchema Json       @default("{}") @map("attribute_schema") @db.JsonB
  schemaVersion   Int        @default(1) @map("schema_version")
  isActive        Boolean    @default(true) @map("is_active")
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  products        Product[]

  @@index([parentId, isActive])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  slug     String    @unique
  name     String
  isActive Boolean   @default(true) @map("is_active")
  products Product[]

  @@map("brands")
}

model Product {
  id               String                 @id @default(uuid()) @db.Uuid
  shopId           String                 @map("shop_id") @db.Uuid
  categoryId       String?                @map("category_id") @db.Uuid
  brandId          String?                @map("brand_id") @db.Uuid
  type             ProductType            @map("product_type")
  status           ProductStatus          @default(DRAFT)
  slug             String                 @unique
  name             String
  description      String
  minPriceAmount   BigInt?                @map("min_price_amount")
  currency         String                 @default("VND") @db.VarChar(3)
  attributes       Json                   @default("{}") @db.JsonB
  attributeVersion Int                    @default(1) @map("attribute_version")
  version          Int                    @default(1)
  firstOrderedAt   DateTime?              @map("first_ordered_at") @db.Timestamptz(6)
  publishedAt      DateTime?              @map("published_at") @db.Timestamptz(6)
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(6)
  shop             Shop                   @relation(fields: [shopId], references: [id])
  category         Category?              @relation(fields: [categoryId], references: [id])
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  physicalDetail   PhysicalProductDetail?
  gameDetail       GameAccountDetail?
  appDetail        AppAccountDetail?
  variants         ProductVariant[]
  appPlans         AppPlan[]
  inventoryItems   InventoryItem[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([shopId, status, createdAt])
  @@index([categoryId, status, minPriceAmount])
  @@index([type, status, createdAt])
  @@map("products")
}

model PhysicalProductDetail {
  productId      String  @id @map("product_id") @db.Uuid
  weightGrams    Int?    @map("weight_grams")
  warrantyMonths Int?    @map("warranty_months")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("physical_product_details")
}

model GameAccountDetail {
  productId             String       @id @map("product_id") @db.Uuid
  gameCatalogId         String       @map("game_catalog_id") @db.Uuid
  platform              String
  server                String?
  loginMethod           String       @map("login_method")
  deliveryMode          String       @map("delivery_mode")
  changeability         Json         @default("{}") @db.JsonB
  warrantyDurationValue Int          @map("warranty_duration_value")
  warrantyDurationUnit  DurationUnit @map("warranty_duration_unit")
  product               Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([gameCatalogId, platform, server])
  @@map("game_account_details")
}

model AppAccountDetail {
  productId            String  @id @map("product_id") @db.Uuid
  applicationCatalogId String  @map("application_catalog_id") @db.Uuid
  setupGuide           Json    @default("[]") @map("setup_guide") @db.JsonB
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([applicationCatalogId])
  @@map("app_account_details")
}

model ProductVariant {
  id              String                 @id @default(uuid()) @db.Uuid
  productId       String                 @map("product_id") @db.Uuid
  sku             String
  name            String
  priceAmount     BigInt                 @map("price_amount")
  compareAtAmount BigInt?                @map("compare_at_amount")
  currency        String                 @default("VND") @db.VarChar(3)
  stockOnHand     Int                    @default(0) @map("stock_on_hand")
  stockReserved   Int                    @default(0) @map("stock_reserved")
  isActive        Boolean                @default(true) @map("is_active")
  version         Int                    @default(1)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservations    InventoryReservation[]

  @@unique([productId, sku])
  @@index([productId, isActive])
  @@map("product_variants")
}

model AppPlan {
  id                      String             @id @default(uuid()) @db.Uuid
  productId               String             @map("product_id") @db.Uuid
  sku                     String
  name                    String
  priceAmount             BigInt             @map("price_amount")
  compareAtAmount         BigInt?            @map("compare_at_amount")
  currency                String             @default("VND") @db.VarChar(3)
  fulfillmentType         AppFulfillmentType @map("fulfillment_type")
  serviceDurationValue    Int                @map("service_duration_value")
  serviceDurationUnit     DurationUnit       @map("service_duration_unit")
  warrantyDurationValue   Int                @map("warranty_duration_value")
  warrantyDurationUnit    DurationUnit       @map("warranty_duration_unit")
  deliveryEstimateMinutes Int?               @map("delivery_estimate_minutes")
  purchaseLimit           Int?               @map("purchase_limit")
  buyerFieldSchema        Json               @default("[]") @map("buyer_field_schema") @db.JsonB
  status                  String             @default("ACTIVE")
  version                 Int                @default(1)
  product                 Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems          InventoryItem[]
  cartItems               CartItem[]
  orderItems              OrderItem[]

  @@unique([productId, sku])
  @@index([productId, status])
  @@map("app_plans")
}

model InventoryItem {
  id                String                 @id @default(uuid()) @db.Uuid
  productId         String                 @map("product_id") @db.Uuid
  appPlanId         String?                @map("app_plan_id") @db.Uuid
  type              InventoryType          @map("inventory_type")
  status            InventoryStatus        @default(DRAFT)
  internalCode      String                 @map("internal_code")
  maskedIdentifier  String?                @map("masked_identifier")
  encryptedPayload  Bytes?                 @map("encrypted_payload")
  encryptedDataKey  Bytes?                 @map("encrypted_data_key")
  payloadNonce      Bytes?                 @map("payload_nonce")
  payloadAuthTag    Bytes?                 @map("payload_auth_tag")
  payloadKeyVersion Int?                   @map("payload_key_version")
  reservedUntil     DateTime?              @map("reserved_until") @db.Timestamptz(6)
  soldOrderItemId   String?                @map("sold_order_item_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  product           Product                @relation(fields: [productId], references: [id])
  appPlan           AppPlan?               @relation(fields: [appPlanId], references: [id])
  soldOrderItem     OrderItem?             @relation("SoldInventory", fields: [soldOrderItemId], references: [id])
  reservations      InventoryReservation[]
  deliveries        DigitalDelivery[]

  @@unique([productId, internalCode])
  @@index([appPlanId, status, createdAt])
  @@index([productId, status, createdAt])
  @@index([soldOrderItemId])
  @@map("inventory_items")
}

model InventoryReservation {
  id               String            @id @default(uuid()) @db.Uuid
  inventoryItemId  String?           @map("inventory_item_id") @db.Uuid
  productVariantId String?           @map("product_variant_id") @db.Uuid
  orderGroupId     String            @map("order_group_id") @db.Uuid
  paymentIntentId  String?           @map("payment_intent_id") @db.Uuid
  quantity         Int               @default(1)
  status           ReservationStatus @default(ACTIVE)
  activeKey        String?           @map("active_key") @db.VarChar(6)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt       DateTime?         @map("released_at") @db.Timestamptz(6)
  inventoryItem    InventoryItem?    @relation(fields: [inventoryItemId], references: [id])
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id])
  orderGroup       OrderGroup        @relation(fields: [orderGroupId], references: [id])
  paymentIntent    PaymentIntent?    @relation(fields: [paymentIntentId], references: [id])

  @@unique([inventoryItemId, activeKey])
  @@index([orderGroupId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id               String          @id @default(uuid()) @db.Uuid
  cartId           String          @map("cart_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  productType      ProductType     @map("product_type")
  productVariantId String?         @map("product_variant_id") @db.Uuid
  appPlanId        String?         @map("app_plan_id") @db.Uuid
  quantity         Int
  selected         Boolean         @default(true)
  buyerFields      Json?           @map("buyer_fields") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  appPlan          AppPlan?        @relation(fields: [appPlanId], references: [id])

  @@index([cartId, selected])
  @@map("cart_items")
}

model CheckoutSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  snapshot     Json      @db.JsonB
  snapshotHash String    @map("snapshot_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@map("checkout_sessions")
}

model OrderGroup {
  id             String                 @id @default(uuid()) @db.Uuid
  buyerId        String                 @map("buyer_id") @db.Uuid
  code           String                 @unique
  status         OrderStatus            @default(PENDING_PAYMENT)
  subtotalAmount BigInt                 @map("subtotal_amount")
  discountAmount BigInt                 @default(0) @map("discount_amount")
  shippingAmount BigInt                 @default(0) @map("shipping_amount")
  taxAmount      BigInt                 @default(0) @map("tax_amount")
  totalAmount    BigInt                 @map("total_amount")
  currency       String                 @default("VND") @db.VarChar(3)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  buyer          User                   @relation(fields: [buyerId], references: [id])
  orders         Order[]
  paymentIntents PaymentIntent[]
  reservations   InventoryReservation[]

  @@index([buyerId, status, createdAt])
  @@map("order_groups")
}

model Order {
  id              String          @id @default(uuid()) @db.Uuid
  orderGroupId    String          @map("order_group_id") @db.Uuid
  shopId          String          @map("shop_id") @db.Uuid
  code            String          @unique
  status          OrderStatus     @default(PENDING_PAYMENT)
  subtotalAmount  BigInt          @map("subtotal_amount")
  discountAmount  BigInt          @default(0) @map("discount_amount")
  shippingAmount  BigInt          @default(0) @map("shipping_amount")
  taxAmount       BigInt          @default(0) @map("tax_amount")
  totalAmount     BigInt          @map("total_amount")
  currency        String          @default("VND") @db.VarChar(3)
  shippingAddress Json?           @map("shipping_address") @db.JsonB
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  group           OrderGroup      @relation(fields: [orderGroupId], references: [id])
  shop            Shop            @relation(fields: [shopId], references: [id])
  items           OrderItem[]
  disputes        Dispute[]
  shipment        Shipment?
  conversations   Conversation[]
  returnRequests  ReturnRequest[]

  @@unique([orderGroupId, shopId])
  @@index([shopId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String             @id @default(uuid()) @db.Uuid
  orderId          String             @map("order_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  productVariantId String?            @map("product_variant_id") @db.Uuid
  appPlanId        String?            @map("app_plan_id") @db.Uuid
  productType      ProductType        @map("product_type")
  quantity         Int
  unitPriceAmount  BigInt             @map("unit_price_amount")
  totalAmount      BigInt             @map("total_amount")
  currency         String             @default("VND") @db.VarChar(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order            Order              @relation(fields: [orderId], references: [id])
  product          Product            @relation(fields: [productId], references: [id])
  productVariant   ProductVariant?    @relation(fields: [productVariantId], references: [id])
  appPlan          AppPlan?           @relation(fields: [appPlanId], references: [id])
  snapshot         OrderItemSnapshot?
  soldInventory    InventoryItem[]    @relation("SoldInventory")
  deliveries       DigitalDelivery[]
  warranty         Warranty?

  @@index([orderId])
  @@index([productId, createdAt])
  @@map("order_items")
}

model OrderItemSnapshot {
  orderItemId           String              @id @map("order_item_id") @db.Uuid
  productName           String              @map("product_name")
  sku                   String?
  planName              String?             @map("plan_name")
  productType           ProductType         @map("product_type")
  fulfillmentType       AppFulfillmentType? @map("fulfillment_type")
  serviceDurationValue  Int?                @map("service_duration_value")
  serviceDurationUnit   DurationUnit?       @map("service_duration_unit")
  warrantyDurationValue Int?                @map("warranty_duration_value")
  warrantyDurationUnit  DurationUnit?       @map("warranty_duration_unit")
  policy                Json                @default("{}") @db.JsonB
  pricing               Json                @db.JsonB
  buyerFieldSchema      Json?               @map("buyer_field_schema") @db.JsonB
  buyerProvidedValues   Json?               @map("buyer_provided_values") @db.JsonB
  orderItem             OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

