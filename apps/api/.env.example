NODE_ENV=development
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=change-this-local-admin-password
PORT=4000
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=09876543210
SEPAY_ACCOUNT_HOLDER=MARKETPLACE VIETNAM
SEPAY_WEBHOOK_SECRET=replace-with-provider-secret
ALLOW_DEV_PAYMENT_SIMULATOR=true
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketplace
S3_ACCESS_KEY=marketplace
S3_SECRET_KEY=marketplace-local-secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760
SHIPPING_PROVIDER=LOCAL
SHIPPING_API_URL=
SHIPPING_API_TOKEN=
SHIPPING_WEBHOOK_SECRET=replace-with-shipping-webhook-secret
KYC_PROVIDER=LOCAL
KYC_API_URL=
KYC_API_TOKEN=
KYC_WEBHOOK_SECRET=replace-with-kyc-webhook-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@marketplace.local
